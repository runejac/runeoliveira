<section id="top" class="signal-hero">
  <div class="signal-field" aria-hidden="true">
    <div class="dot-field"></div>
    <div class="cursor-light"></div>
    <div class="orbit orbit-one"></div>
    <div class="orbit orbit-two"></div>
    <div class="scanner"></div>
  </div>

  <div class="hero-inner section-shell">
    <div class="hero-index">
      <span>Rune Oliveira</span>
      <span>Oslo · 59.9° N</span>
    </div>

    <div class="hero-copy">
      <p class="eyebrow">Software engineer · media industry</p>
      <h1>Making complex things <em>feel clear.</em></h1>
    </div>

    <div class="hero-bottom">
      <p>
        I build digital products where product thinking, frontend craft, and
        dependable engineering meet.
      </p>
      <a href="#approach">Enter the method <span aria-hidden="true">↘</span></a
      >
    </div>

    <aside class="status-note">
      <span class="pulse" aria-hidden="true"></span>
      <div>
        <small>Current signal</small>
        <p>Building for people, not page views.</p>
      </div>
    </aside>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.signal-hero');
  const precisePointer = window.matchMedia('(pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero) {
    const scanner = hero.querySelector<HTMLElement>('.scanner');
    const orbits = hero.querySelectorAll<HTMLElement>('.orbit');

    orbits.forEach((orbit) => {
      const orbitDuration = Number.parseFloat(
        window.getComputedStyle(orbit).animationDuration,
      );

      if (Number.isFinite(orbitDuration) && orbitDuration > 0) {
        orbit.style.animationDelay = `-${Math.random() * orbitDuration}s`;
      }

      const dot = document.createElement('span');
      dot.className = 'orbit-dot';

      Array.from(orbit.attributes).forEach(({ name, value }) => {
        if (name.startsWith('data-astro-cid-')) {
          dot.setAttribute(name, value);
        }
      });

      orbit.append(dot);
    });

    if (precisePointer.matches && !reducedMotion.matches) {
      let pointerFrame = 0;

      hero.addEventListener('pointermove', (event) => {
        cancelAnimationFrame(pointerFrame);
        pointerFrame = requestAnimationFrame(() => {
          const bounds = hero.getBoundingClientRect();
          hero.style.setProperty(
            '--pointer-x',
            `${event.clientX - bounds.left}px`,
          );
          hero.style.setProperty(
            '--pointer-y',
            `${event.clientY - bounds.top}px`,
          );
        });
      });
    }

    if (scanner && !reducedMotion.matches) {
      const dots = Array.from(hero.querySelectorAll<HTMLElement>('.orbit-dot'));
      const collidingDots = new WeakSet<HTMLElement>();
      let collisionFrame = 0;

      const triggerImpact = (dot: HTMLElement) => {
        const impactColor = window.getComputedStyle(dot).color;

        dot.classList.remove('hit');
        scanner.classList.remove('impact');
        scanner.style.setProperty('--scanner-color', impactColor);
        void dot.offsetWidth;
        dot.classList.add('hit');
        scanner.classList.add('impact');

        window.setTimeout(() => {
          dot.classList.remove('hit');
          scanner.classList.remove('impact');
          scanner.style.removeProperty('--scanner-color');
        }, 700);
      };

      const checkCollisions = () => {
        const scannerBounds = scanner.getBoundingClientRect();
        const scannerX = scannerBounds.left + scannerBounds.width / 2;
        const scannerVisible =
          Number.parseFloat(window.getComputedStyle(scanner).opacity) > 0.08;

        dots.forEach((dot) => {
          const dotBounds = dot.getBoundingClientRect();
          const dotX = dotBounds.left + dotBounds.width / 2;
          const dotY = dotBounds.top + dotBounds.height / 2;
          const dotIsVisible =
            dotX >= 0 &&
            dotX <= window.innerWidth &&
            dotY >= 0 &&
            dotY <= window.innerHeight;
          const isColliding =
            scannerVisible && dotIsVisible && Math.abs(scannerX - dotX) <= 7;

          if (isColliding && !collidingDots.has(dot)) {
            collidingDots.add(dot);
            triggerImpact(dot);
          } else if (!isColliding) {
            collidingDots.delete(dot);
          }
        });

        collisionFrame = requestAnimationFrame(checkCollisions);
      };

      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting && collisionFrame === 0) {
            collisionFrame = requestAnimationFrame(checkCollisions);
          } else if (!entry.isIntersecting) {
            cancelAnimationFrame(collisionFrame);
            collisionFrame = 0;
          }
        },
        { threshold: 0.05 },
      );

      visibilityObserver.observe(hero);
    }
  }
</script>

<style>
