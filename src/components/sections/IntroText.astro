<section id="top" class="signal-hero">
  <div class="signal-field" aria-hidden="true">
    <div class="dot-field"></div>
    <div class="cursor-light"></div>
    <div class="orbit orbit-one"></div>
    <div class="orbit orbit-two"></div>
    <div class="scanner"></div>
  </div>

  <div class="hero-inner section-shell">
    <div class="hero-index">
      <span>Rune Oliveira</span>
      <span>Oslo · 59.9° N</span>
    </div>

    <div class="hero-copy">
      <p class="eyebrow">Software engineer · media industry</p>
      <h1>Making complex things <em>feel clear.</em></h1>
    </div>

    <div class="hero-bottom">
      <p>
        I build digital products where product thinking, frontend craft, and
        dependable engineering meet.
      </p>
      <a href="#approach">Enter the method <span aria-hidden="true">↘</span></a
      >
    </div>

    <aside class="status-note">
      <span class="pulse" aria-hidden="true"></span>
      <div>
        <small>Current signal</small>
        <p>Currently building digital products for Norwegian media.</p>
      </div>
    </aside>
  </div>
</section>

<script>
  import { animate } from 'motion/mini';

  const hero = document.querySelector<HTMLElement>('.signal-hero');
  const precisePointer = window.matchMedia('(pointer: fine)');
  const compactViewport = window.matchMedia('(max-width: 47.99rem)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero) {
    const scanner = hero.querySelector<HTMLElement>('.scanner');
    const orbits = hero.querySelectorAll<HTMLElement>('.orbit');

    orbits.forEach((orbit) => {
      const orbitDuration = Number.parseFloat(
        window.getComputedStyle(orbit).animationDuration,
      );

      if (Number.isFinite(orbitDuration) && orbitDuration > 0) {
        orbit.style.animationDelay = `-${Math.random() * orbitDuration}s`;
      }

      const dot = document.createElement('span');
      dot.className = 'orbit-dot';

      Array.from(orbit.attributes).forEach(({ name, value }) => {
        if (name.startsWith('data-astro-cid-')) {
          dot.setAttribute(name, value);
        }
      });

      orbit.append(dot);
    });

    if (precisePointer.matches && !reducedMotion.matches) {
      let pointerFrame = 0;

      hero.addEventListener('pointermove', (event) => {
        cancelAnimationFrame(pointerFrame);
        pointerFrame = requestAnimationFrame(() => {
          const bounds = hero.getBoundingClientRect();
          hero.style.setProperty(
            '--pointer-x',
            `${event.clientX - bounds.left}px`,
          );
          hero.style.setProperty(
            '--pointer-y',
            `${event.clientY - bounds.top}px`,
          );
        });
      });
    }

    if (scanner && !reducedMotion.matches) {
      const dots = Array.from(hero.querySelectorAll<HTMLElement>('.orbit-dot'));
      const collidingDots = new WeakSet<HTMLElement>();
      let collisionFrame = 0;

      const launchImpactWave = (
        dot: HTMLElement,
        impactColor: string,
        className: string,
        delay: number,
        duration: number,
        reach: number,
        peakOpacity: number,
      ) => {
        const heroBounds = hero.getBoundingClientRect();
        const dotBounds = dot.getBoundingClientRect();
        const wave = document.createElement('span');

        wave.className = `impact-wave ${className}`;
        wave.setAttribute('aria-hidden', 'true');
        wave.style.left = `${dotBounds.left + dotBounds.width / 2 - heroBounds.left}px`;
        wave.style.top = `${dotBounds.top + dotBounds.height / 2 - heroBounds.top}px`;
        wave.style.setProperty('--impact-color', impactColor);

        Array.from(dot.attributes).forEach(({ name, value }) => {
          if (name.startsWith('data-astro-cid-')) {
            wave.setAttribute(name, value);
          }
        });

        hero.append(wave);
        animate(
          wave,
          {
            opacity: [0, peakOpacity, peakOpacity * 0.62, 0],
            transform: [
              'translate(-50%, -50%) scale(0.4)',
              'translate(-50%, -50%) scale(0.9)',
              `translate(-50%, -50%) scale(${reach * 0.38})`,
              `translate(-50%, -50%) scale(${reach})`,
            ],
          },
          {
            delay,
            duration,
            ease: [0.16, 1, 0.3, 1],
            times: [0, 0.08, 0.36, 1],
          },
        );

        window.setTimeout(
          () => wave.remove(),
          (delay + duration) * 1000 + 100,
        );
      };

      const triggerImpact = (dot: HTMLElement) => {
        const impactColor = window.getComputedStyle(dot).color;

        if (compactViewport.matches) {
          launchImpactWave(
            dot,
            impactColor,
            'impact-wave-primary',
            0,
            0.62,
            5.2,
            0.42,
          );
        } else {
          launchImpactWave(
            dot,
            impactColor,
            'impact-wave-primary',
            0,
            0.72,
            7.8,
            0.58,
          );
          launchImpactWave(
            dot,
            impactColor,
            'impact-wave-echo',
            0.06,
            0.94,
            10.5,
            0.24,
          );
        }

        dot.classList.remove('hit');
        scanner.classList.remove('impact');
        scanner.style.setProperty('--scanner-color', impactColor);
        void dot.offsetWidth;
        dot.classList.add('hit');
        scanner.classList.add('impact');

        window.setTimeout(() => {
          dot.classList.remove('hit');
          scanner.classList.remove('impact');
          scanner.style.removeProperty('--scanner-color');
        }, 700);
      };

      const checkCollisions = () => {
        const scannerBounds = scanner.getBoundingClientRect();
        const scannerX = scannerBounds.left + scannerBounds.width / 2;
        const scannerVisible =
          Number.parseFloat(window.getComputedStyle(scanner).opacity) > 0.08;

        dots.forEach((dot) => {
          const dotBounds = dot.getBoundingClientRect();
          const dotX = dotBounds.left + dotBounds.width / 2;
          const dotY = dotBounds.top + dotBounds.height / 2;
          const dotIsVisible =
            dotBounds.width > 0 &&
            dotBounds.height > 0 &&
            dotX >= 0 &&
            dotX <= window.innerWidth &&
            dotY >= 0 &&
            dotY <= window.innerHeight;
          const scannerDistance = Math.abs(scannerX - dotX);
          const proximityRange = compactViewport.matches ? 110 : 200;
          const rawProximity =
            scannerVisible && dotIsVisible
              ? Math.max(0, 1 - scannerDistance / proximityRange)
              : 0;
          const proximity =
            rawProximity * rawProximity * (3 - 2 * rawProximity);
          const isColliding =
            scannerVisible && dotIsVisible && scannerDistance <= 7;

          dot.style.setProperty('--proximity', proximity.toFixed(3));

          if (isColliding && !collidingDots.has(dot)) {
            collidingDots.add(dot);
            triggerImpact(dot);
          } else if (!isColliding) {
            collidingDots.delete(dot);
          }
        });

        collisionFrame = requestAnimationFrame(checkCollisions);
      };

      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting && collisionFrame === 0) {
            collisionFrame = requestAnimationFrame(checkCollisions);
          } else if (!entry.isIntersecting) {
            cancelAnimationFrame(collisionFrame);
            collisionFrame = 0;
            dots.forEach((dot) => dot.style.removeProperty('--proximity'));
          }
        },
        { threshold: 0.05 },
      );

      visibilityObserver.observe(hero);
    }
  }
</script>

<style>
  .signal-hero {
    --pointer-x: 70%;
    --pointer-y: 32%;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: var(--night);
  }

  .signal-field,
  .dot-field,
  .cursor-light,
  .scanner {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .dot-field {
    opacity: 0.32;
    background-image: radial-gradient(
      rgba(237, 241, 232, 0.34) 0.8px,
      transparent 0.8px
    );
    background-size: 24px 24px;
    mask-image: radial-gradient(circle at 66% 42%, black 0, transparent 58%);
  }

  .cursor-light {
    opacity: 0.85;
    background: radial-gradient(
      circle 24rem at var(--pointer-x) var(--pointer-y),
      rgba(142, 125, 255, 0.2),
      rgba(184, 255, 88, 0.07) 35%,
      transparent 70%
    );
    transition: background-position 100ms linear;
  }

  .orbit {
    position: absolute;
    border: 1px solid rgba(184, 255, 88, 0.16);
    border-radius: 50%;
  }

  .orbit-dot {
    --proximity: 0;
    --impact-scale: 2.1;

    position: absolute;
    top: 50%;
    left: 100%;
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    color: var(--signal);
    background: var(--signal);
    box-shadow: 0 0 calc(1.35rem + (var(--proximity) * 1.7rem))
      color-mix(in srgb, currentColor 85%, transparent);
    transform: translate(-50%, -50%)
      scale(calc(1 + (var(--proximity) * 0.42)));
    transition:
      box-shadow 80ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 80ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .orbit-two .orbit-dot {
    color: var(--violet);
    background: var(--violet);
  }

  .orbit-dot::before,
  .orbit-dot::after {
    position: absolute;
    top: 50%;
    left: 50%;
    opacity: 0;
    content: '';
    pointer-events: none;
  }

  .orbit-dot::before {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--signal);
    opacity: calc(var(--proximity) * 0.42);
    transform: translate(-50%, -50%)
      scale(calc(1 + (var(--proximity) * 2.8)));
    transition:
      opacity 90ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 90ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .orbit-two .orbit-dot::before {
    color: var(--violet);
  }

  .orbit-dot::after {
    width: 2.8rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor, transparent);
    color: var(--signal);
    transform: translate(-50%, -50%);
  }

  .orbit-two .orbit-dot::after {
    color: var(--violet);
  }

  .orbit-dot.hit {
    animation: impact-core 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .orbit-dot.hit::before {
    animation: impact-ring 440ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .orbit-dot.hit::after {
    animation: impact-spark 580ms ease-out;
  }

  .impact-wave {
    position: absolute;
    z-index: 1;
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--impact-color) 82%, white);
    border-radius: 50%;
    opacity: 0;
    box-shadow:
      0 0 0.75rem color-mix(in srgb, var(--impact-color) 62%, transparent),
      inset 0 0 0.5rem color-mix(in srgb, var(--impact-color) 40%, transparent);
    transform: translate(-50%, -50%) scale(0.4);
    mix-blend-mode: screen;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .impact-wave-echo {
    border-color: color-mix(in srgb, var(--impact-color) 48%, transparent);
    box-shadow: 0 0 1rem
      color-mix(in srgb, var(--impact-color) 30%, transparent);
    filter: blur(0.45px);
  }

  .orbit-one {
    top: 12%;
    right: -9rem;
    width: min(54vw, 48rem);
    aspect-ratio: 1;
    animation: orbit 34s linear infinite;
  }

  .orbit-two {
    right: 7%;
    bottom: -16rem;
    width: min(34vw, 30rem);
    aspect-ratio: 1;
    border-color: rgba(142, 125, 255, 0.19);
    animation: orbit 46s linear infinite reverse;
  }

  .scanner {
    --scanner-color: #70d8ff;
    width: 1px;
    opacity: 0.24;
    background: linear-gradient(
      transparent 5%,
      var(--scanner-color),
      transparent 88%
    );
    box-shadow: 0 0 2rem
      color-mix(in srgb, var(--scanner-color) 38%, transparent);
    animation: scan 16s var(--ease) infinite;
    transition:
      background 140ms ease,
      box-shadow 140ms ease;
  }

  .scanner::after {
    position: absolute;
    inset: 0 -0.4rem;
    opacity: 0;
    background: linear-gradient(
      transparent 5%,
      var(--scanner-color),
      transparent 88%
    );
    box-shadow: 0 0 2.4rem
      color-mix(in srgb, var(--scanner-color) 75%, transparent);
    content: '';
  }

  .scanner.impact::after {
    animation: line-impact 620ms ease-out;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 100svh;
    padding-block: 7rem 2rem;
    align-content: space-between;
    gap: 3rem;
  }

  .hero-index {
    display: flex;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 0.61rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .hero-copy {
    max-width: 76rem;
    animation: arrive 800ms 100ms var(--ease) both;
  }

  h1 {
    max-width: 10ch;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    font-family: var(--display);
    font-size: clamp(4.2rem, 11.5vw, 11rem);
    font-weight: 300;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  h1 em {
    display: block;
    color: var(--signal);
    font-style: normal;
  }

  .hero-bottom {
    display: grid;
    max-width: 58rem;
    align-items: end;
    gap: 1.5rem;
  }

  .hero-bottom p {
    max-width: 34rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }

  .hero-bottom a {
    width: max-content;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--signal);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .status-note {
    display: flex;
    max-width: 19rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    align-items: flex-start;
    gap: 0.8rem;
    background: rgba(14, 19, 23, 0.72);
    backdrop-filter: blur(12px);
  }

  .pulse {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.25rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 1rem var(--signal);
    animation: pulse 2.6s ease-in-out infinite;
    flex: 0 0 auto;
  }

  .status-note small {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-note p {
    margin-top: 0.2rem;
    font-size: 0.85rem;
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes orbit {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes scan {
    0%,
    14% {
      transform: translateX(-2vw);
      opacity: 0;
    }
    22% {
      opacity: 0.24;
    }
    78% {
      opacity: 0.24;
    }
    86%,
    100% {
      transform: translateX(102vw);
      opacity: 0;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.42;
      transform: scale(0.72);
    }
  }

  @keyframes impact-core {
    35% {
      box-shadow:
        0 0 0.8rem currentColor,
        0 0 2.4rem currentColor;
      transform: translate(-50%, -50%) scale(var(--impact-scale));
    }
  }

  @keyframes impact-ring {
    0% {
      opacity: 0.72;
      transform: translate(-50%, -50%) scale(0.75);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(3.2);
    }
  }

  @keyframes impact-spark {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scaleX(0.2);
    }
    35% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scaleX(1.8);
    }
  }

  @keyframes line-impact {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .orbit-one {
      top: 14%;
      right: -36vw;
      width: min(92vw, 28rem);
      border-color: rgba(184, 255, 88, 0.12);
      animation-duration: 42s;
    }

    .orbit-two {
      display: none;
    }

    .orbit-dot {
      --impact-scale: 1.65;

      width: 0.46rem;
      height: 0.46rem;
      box-shadow: 0 0 calc(0.95rem + (var(--proximity) * 1rem))
        color-mix(in srgb, currentColor 75%, transparent);
      transform: translate(-50%, -50%)
        scale(calc(1 + (var(--proximity) * 0.32)));
    }

    .orbit-dot::before {
      width: 0.46rem;
      height: 0.46rem;
      transform: translate(-50%, -50%)
        scale(calc(1 + (var(--proximity) * 2)));
    }

    .orbit-dot::after {
      width: 2rem;
    }

    .impact-wave {
      width: 0.65rem;
      height: 0.65rem;
      border-color: color-mix(in srgb, var(--impact-color) 68%, white);
      box-shadow: 0 0 0.55rem
        color-mix(in srgb, var(--impact-color) 46%, transparent);
    }
  }

  @media (min-width: 48rem) {
    .hero-inner {
      padding-block: 7.5rem 2.5rem;
      grid-template-columns: 1fr auto;
    }

    .hero-index,
    .hero-copy {
      grid-column: 1 / -1;
    }

    .hero-bottom {
      grid-template-columns: 1fr auto;
    }

    .status-note {
      align-self: end;
    }
  }
</style>
