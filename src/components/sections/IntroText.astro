  }

  .orbit {
    position: absolute;
    border: 1px solid rgba(184, 255, 88, 0.16);
    border-radius: 50%;
  }

  .orbit-dot {
    position: absolute;
    top: 50%;
    left: 100%;
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    color: var(--signal);
    background: var(--signal);
    box-shadow: 0 0 1.5rem rgba(184, 255, 88, 0.85);
    transform: translate(-50%, -50%);
  }

  .orbit-two .orbit-dot {
    color: var(--violet);
    background: var(--violet);
    box-shadow: 0 0 1.5rem rgba(142, 125, 255, 0.85);
  }

  .orbit-dot::before,
  .orbit-dot::after {
    position: absolute;
    top: 50%;
    left: 50%;
    opacity: 0;
    content: '';
    pointer-events: none;
  }

  .orbit-dot::before {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--signal);
    transform: translate(-50%, -50%);
  }

  .orbit-two .orbit-dot::before {
    color: var(--violet);
  }

  .orbit-dot::after {
    width: 2.8rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor, transparent);
    color: var(--signal);
    transform: translate(-50%, -50%);
  }

  .orbit-two .orbit-dot::after {
    color: var(--violet);
  }

  .orbit-dot.hit {
    animation: impact-core 650ms var(--ease);
  }

  .orbit-dot.hit::before {
