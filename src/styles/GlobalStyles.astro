<style is:global>
  :root {
    color-scheme: light;
    --background: #faf9f6;
    --text: #292b29;
    --body: #50534e;
    --muted: #6d7069;
    --line: #dedfd8;
    --link: #355e79;
    --mono: ui-monospace, 'Cascadia Code', 'SFMono-Regular', Consolas, monospace;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    background: var(--background);
  }
  body {
    width: min(100% - 3rem, 40rem);
    margin-inline: auto;
    color: var(--body);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 1rem;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }
  h2 {
    margin-bottom: 0.75rem;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  section + section {
    margin-top: 2.5rem;
  }
  p + p {
    margin-top: 1rem;
  }
  a {
    color: var(--link);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--text);
  }
  ::selection {
    color: var(--text);
    background: #e1e7df;
  }
  :focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 5px;
  }
  .skip-link {
    position: absolute;
    top: -5rem;
    left: 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--background);
  }
  .skip-link:focus {
    top: 0.5rem;
  }
</style>
